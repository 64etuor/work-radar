{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main Work Radar window. Window show/hide drives the Raycast-style global-hotkey toggle; drag-region enables moving the decorationless window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-start-dragging",
    "global-shortcut:default",
    "opener:allow-open-url",
    "notification:default",
    "dialog:allow-open"
  ]
}
